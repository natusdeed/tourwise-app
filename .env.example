# Lead magnet email delivery (server-side only for API routes)
# Add these same keys in Vercel -> Project Settings -> Environment Variables.
RESEND_API_KEY=
# Preferred sender key for lead magnets:
LEAD_MAGNET_FROM_EMAIL=hello@tourwiseai.com
# Optional reply-to for lead magnet emails:
LEAD_MAGNET_REPLY_TO_EMAIL=support@tourwiseai.com
# Backward-compatible fallback sender key used by existing routes:
RESEND_FROM_EMAIL=hello@tourwiseai.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_AMAZON_TAG=
